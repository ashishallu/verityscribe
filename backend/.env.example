ENVIRONMENT=development
API_PREFIX=/api/v1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_NEVER_EXPOSE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
