ENVIRONMENT=development
API_PREFIX=/api/v1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_NEVER_EXPOSE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
# Used only by any existing non-ASR Hugging Face features; ASR never routes to HF.
HUGGINGFACE_TOKEN=YOUR_SERVER_SIDE_HF_TOKEN
# Optional document-image provider. When both are set, Cloudflare Vision is
# used for image reports; secrets must stay on the backend, never in Flutter.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# Flux uses Cloudflare's default AI Gateway; authenticated gateway access and
# an Account AI Gateway Run token permission are required. This is not secret.
CLOUDFLARE_AI_GATEWAY=default
# The default ASR ensemble uses only allowlisted Cloudflare Workers AI models.
# Keep the Cloudflare account on Workers Free to ensure requests stop at the
# included daily allowance rather than billing overage on a Paid plan.
# Optional override accepts only the same allowlisted Cloudflare model IDs.
AI_ASR_MODELS_JSON=
AI_ASR_TIMEOUT_SECONDS=45
AI_ASR_MAX_RETRIES=1
AI_TRANSCRIPT_RECONCILER_TIMEOUT_SECONDS=35
# Compatibility alias for older deployments; prefer AI_ASR_PRIMARY_BASE_URL.
AI_ASR_BASE_URL=
AI_LLM_BASE_URL=http://llm-service.internal/v1/draft
# Qwen reconciliation endpoint. It must return JSON, never a fabricated transcript.
AI_TRANSCRIPT_RECONCILER_BASE_URL=http://llm-service.internal/v1/reconcile
# ASR defaults: whisper, whisper-tiny-en, nova-3, Flux (WebSocket), and
# whisper-large-v3-turbo (Base64 batch audio).
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://verityscribe-admin-portal.vercel.app
