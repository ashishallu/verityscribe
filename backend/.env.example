ENVIRONMENT=development
API_PREFIX=/api/v1
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
SUPABASE_SERVICE_ROLE_KEY=SERVER_ONLY_NEVER_EXPOSE
SUPABASE_JWT_SECRET=YOUR_JWT_SECRET
HUGGINGFACE_TOKEN=OPTIONAL_HF_TOKEN
# Optional document-image provider. When both are set, Cloudflare Vision is
# used for image reports; secrets must stay on the backend, never in Flutter.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_VISION_MODEL=@cf/meta/llama-3.2-11b-vision-instruct
# Legacy custom ASR endpoint examples. The default ensemble uses Hugging Face
# provider routing instead; configure custom endpoints inside AI_ASR_MODELS_JSON.
AI_ASR_PRIMARY_BASE_URL=http://asr-primary.internal/v1/transcribe
AI_ASR_SECONDARY_BASE_URL=http://asr-secondary.internal/v1/transcribe
# Default is a five-model parallel ensemble via Hugging Face Inference Providers:
# Whisper large-v3 (fal-ai), Whisper large-v3-turbo (DeepInfra), Qwen3-ASR 0.6B
# and 1.7B (DeepInfra), and NVIDIA Parakeet TDT 0.6B v3 (Together AI).
# Set AI_ASR_MODELS_JSON only to override this list. Entries accept model, weight,
# provider, and optional endpoint (for your own compatible inference endpoint).
# Example: AI_ASR_MODELS_JSON=[{"model":"openai/whisper-large-v3","provider":"fal-ai","weight":1.2}]
AI_ASR_MODELS_JSON=
AI_ASR_TIMEOUT_SECONDS=60
AI_TRANSCRIPT_RECONCILER_TIMEOUT_SECONDS=35
# Compatibility alias for older deployments; prefer AI_ASR_PRIMARY_BASE_URL.
AI_ASR_BASE_URL=
AI_LLM_BASE_URL=http://llm-service.internal/v1/draft
# Qwen reconciliation endpoint. It must return JSON, never a fabricated transcript.
AI_TRANSCRIPT_RECONCILER_BASE_URL=http://llm-service.internal/v1/reconcile
# The five ASR model IDs above are the default speech-recognition targets.
CORS_ORIGINS=http://localhost:3000,http://localhost:8080,https://verityscribe-admin-portal.vercel.app
